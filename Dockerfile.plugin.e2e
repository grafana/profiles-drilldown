FROM mcr.microsoft.com/playwright:v1.59.0-noble@sha256:11707c5282fec52f0705aad3a23f46b3409b3de4aed378b3dbe118d8b8c87b67

WORKDIR /app

# required by the e2e test code (keep in sync with base image browser bundles)
RUN corepack enable && pnpm add --ignore-scripts "@playwright/test@1.59.0" "dotenv@^16.3.1" "@grafana/plugin-e2e@^3.15.3"

ENV E2E_BASE_URL="http://localhost:3000"

ENV TZ=Europe/Madrid

ENTRYPOINT ["pnpm", "exec", "playwright", "test", "-c", "e2e/config/playwright.config.ci.ts"]
