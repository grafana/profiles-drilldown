{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Grafana Profiles Drilldown",
  "id": "grafana-pyroscope-app",
  "autoEnabled": true,
  "backend": false,
  "preload": true,
  "languages": [
    "en-US",
    "cs-CZ",
    "de-DE",
    "es-ES",
    "fr-FR",
    "hu-HU",
    "id-ID",
    "it-IT",
    "ja-JP",
    "ko-KR",
    "nl-NL",
    "pl-PL",
    "pt-BR",
    "pt-PT",
    "ru-RU",
    "sv-SE",
    "tr-TR",
    "zh-Hans",
    "zh-Hant"
  ],
  "dependencies": {
    "grafanaDependency": ">=13.1.0-0",
    "plugins": [],
    "extensions": {
      "exposedComponents": [
        "grafana-o11yinsights-app/insights-launcher/v1",
        "grafana-adaptiveprofiles-app/resolution-boost/v1",
        "grafana-adaptiveprofiles-app/sampling-indicator/v1",
        "grafana/query-library-context/v1",
        "grafana/add-to-dashboard-form/v1"
      ]
    }
  },
  "info": {
    "keywords": ["app", "pyroscope", "profiling", "explore", "profiles", "performance", "drilldown"],
    "description": "View and analyze high-level service performance, identify problem processes for optimization, and diagnose issues to determine root causes.",
    "author": {
      "name": "Grafana"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [
      {
        "name": "Hero Image",
        "path": "img/hero-image.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%",
    "links": [
      {
        "name": "GitHub",
        "url": "https://github.com/grafana/profiles-drilldown"
      },
      {
        "name": "Report bug",
        "url": "https://github.com/grafana/profiles-drilldown/issues/new?template=bug_report.md"
      }
    ]
  },
  "includes": [
    {
      "type": "page",
      "name": "Profiles",
      "path": "/a/%PLUGIN_ID%/explore",
      "action": "datasources:explore",
      "addToNav": true,
      "defaultNav": true
    }
  ],
  "extensions": {
    "exposedComponents": [
      {
        "id": "grafana-pyroscope-app/embedded-profiles-exploration/v1",
        "title": "Embedded Profiles Exploration",
        "description": "A component that renders a profiles exploration view that can be embedded in other parts of Grafana."
      }
    ],
    "extensionPoints": [
      {
        "id": "grafana-pyroscope-app/settings/v1"
      }
    ],
    "addedLinks": [
      {
        "title": "Open in Grafana Profiles Drilldown",
        "description": "Try our new queryless experience for profiles",
        "targets": [
          "grafana/explore/toolbar/action",
          "grafana/traceview/details",
          "grafana-assistant-app/navigateToDrilldown/v1"
        ]
      }
    ]
  },
  "routes": [
    {
      "path": "jev",
      "method": "POST",
      "url": "{{ if .JsonData.semanticClassificationEnabled }}{{ if .SecureJsonData.jevApiKey }}https://openrouter.ai/api/v1/systemone{{ end }}{{ end }}",
      "reqSignedIn": true,
      "reqRole": "Admin",
      "headers": [
        {
          "name": "Authorization",
          "content": "Bearer {{ .SecureJsonData.jevApiKey }}"
        },
        { "name": "X-Grafana-Context", "content": "" },
        { "name": "X-Grafana-Id", "content": "" },
        { "name": "X-Grafana-User", "content": "" },
        { "name": "X-Grafana-Org-Id", "content": "" },
        { "name": "X-Grafana-NoCache", "content": "" },
        { "name": "X-Grafana-Device-Id", "content": "" },
        { "name": "X-Grafana-Referer", "content": "" },
        { "name": "Referer", "content": "" },
        { "name": "Traceparent", "content": "" },
        { "name": "Tracestate", "content": "" },
        { "name": "Baggage", "content": "" },
        { "name": "X-Request-Id", "content": "" },
        { "name": "User-Agent", "content": "" },
        { "name": "Accept-Language", "content": "" },
        { "name": "Sec-CH-UA", "content": "" },
        { "name": "Sec-CH-UA-Mobile", "content": "" },
        { "name": "Sec-CH-UA-Platform", "content": "" },
        { "name": "Sec-CH-UA-Platform-Version", "content": "" },
        { "name": "Sec-CH-UA-Arch", "content": "" },
        { "name": "Sec-CH-UA-Bitness", "content": "" },
        { "name": "Sec-CH-UA-Full-Version", "content": "" },
        { "name": "Sec-CH-UA-Full-Version-List", "content": "" },
        { "name": "Sec-CH-UA-Model", "content": "" },
        { "name": "Sec-Fetch-Dest", "content": "" },
        { "name": "Sec-Fetch-Mode", "content": "" },
        { "name": "Sec-Fetch-Site", "content": "" },
        { "name": "Sec-Fetch-User", "content": "" },
        { "name": "Priority", "content": "" },
        { "name": "DNT", "content": "" },
        { "name": "Sec-GPC", "content": "" },
        { "name": "Forwarded", "content": "" },
        { "name": "X-Real-Ip", "content": "" },
        { "name": "X-Forwarded-For", "content": "" },
        { "name": "Uber-Trace-Id", "content": "" }
      ]
    },
    {
      "path": "/grafanacom-api/instances",
      "method": "GET",
      "url": "{{.SecureJsonData.gcomApiUrl}}/instances/{{.SecureJsonData.stackId}}",
      "headers": [
        {
          "name": "Authorization",
          "content": "Bearer {{.SecureJsonData.gcomApiToken}}"
        }
      ]
    }
  ]
}
