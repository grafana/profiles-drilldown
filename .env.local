## COPY THIS FILE CONTENT TO A .env FILE THEN ADD THE SECRET VALUES AND CONFIGURATIONS OVERRIDES THAT WILL BE USED ON YOUR LOCAL MACHINE ONLY

## Use a specific version of Grafana 
# GRAFANA_IMAGE=grafana
# GRAFANA_VERSION=10.1.1

## Use a locally built grafana image running `make build-docker-full` on your local copy of grafana/grafana
# GRAFANA_IMAGE=grafana-oss
# GRAFANA_VERSION=dev

## Use a specific grafana/grafana PR dev build.
# GRAFANA_IMAGE=grafana-dev
# GRAFANA_VERSION=10.3.0-143284

## Override the default port
# GRAFANA_PORT=3003

# Grafana feature toggles (comma-separated), consumed by docker-compose.local.yaml and
# docker-compose.remote.yaml. profilesHeatmap enables the span profiles heatmap;
# metricsFromProfiles is required by it.
GF_FEATURE_TOGGLES_ENABLE=localizationForPlugins,profilesHeatmap,metricsFromProfiles

# Credentials for fetching remote profile data
REMOTE_BACKEND_URL=
REMOTE_BASIC_AUTH_USER=
REMOTE_BASIC_AUTH_PASSWORD=

# Credentials for the remote Tempo datasource (span profiles -> traces).
# Enables the "Tempo datasource" picker in the span exemplar table (server:remote).
REMOTE_TRACE_BACKEND_URL=
REMOTE_TRACE_BASIC_AUTH_USER=
REMOTE_TRACE_BASIC_AUTH_PASSWORD=

# E2E tests
E2E_BASE_URL=http://localhost:3000
E2E_USERNAME=
E2E_PASSWORD=

# GITHUB INTEGRATION (FUNCTION DETAILS)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SESSION_SECRET=

# AI INTEGRATION ("EXPLAIN FLAME GRAPH")
OPENAI_ORGANIZATION_ID=
OPENAI_API_KEY=